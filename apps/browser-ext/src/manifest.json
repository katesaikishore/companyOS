{
  "manifest_version": 3,
  "name": "companyOS Twin Browser Bridge",
  "version": "0.1.0",
  "description": "Sends only the host and path shape of the active tab to companyOS Twin, and only when capture is on in the app.",
  "key": "",
  "incognito": "not_allowed",
  "permissions": ["tabs", "nativeMessaging"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
