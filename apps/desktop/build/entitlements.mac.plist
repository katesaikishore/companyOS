<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Electron's JavaScript engine needs executable memory under the hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- The same key electron-builder sets by default for Electron apps (electron-builder issue 3940). -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Lets the app ask System Events which app is in front. The usage text is NSAppleEventsUsageDescription in electron-builder.yml. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
  </dict>
</plist>
